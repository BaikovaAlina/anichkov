{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anichkov-reports",
  "main": "handler.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://baikovaalina.github.io"
  },
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
